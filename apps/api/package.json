{
  "name": "@level-logger/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc -p .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "device": "tsx --env-file-if-exists=../../.env src/db/device-cli.ts",
    "test": "vitest run",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "dev:db": "tsx scripts/dev-db.ts",
    "db:seed-dev": "tsx --env-file-if-exists=../../.env src/db/seed-dev.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@level-logger/shared": "^0.0.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.15",
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
