{
  "name": "level-logger",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,green --kill-others-on-fail \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @level-logger/api",
    "dev:web": "npm run dev -w @level-logger/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w @level-logger/api",
    "db:migrate": "npm run db:migrate -w @level-logger/api",
    "device": "npm run device -w @level-logger/api --",
    "test": "npm run test --workspaces --if-present",
    "build:web": "npm run build -w @level-logger/web",
    "build:api": "npm run build -w @level-logger/api",
    "build": "npm run build:web && npm run build:api",
    "dev:db": "npm run dev:db -w @level-logger/api",
    "db:seed-dev": "npm run db:seed-dev -w @level-logger/api --"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2"
  }
}
