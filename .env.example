# Port 5433 so it does not collide with a native Postgres or the flashcards project on 5432.
DATABASE_URL=postgres://level_logger:level_logger@localhost:5433/level_logger
PORT=3000

# Production only (see Dockerfile and deploy/README.md):
# NODE_ENV=production
# Only behind a trusted reverse proxy (Caddy); makes rate limiting use the real client IP.
# TRUST_PROXY=true
# Directory of the built web app for the API to serve.
# WEB_DIST=/app/web
# MIGRATIONS_DIR=/app/apps/api/drizzle
